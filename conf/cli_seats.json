      "host_dedup_frontends": [
        "codex"
      ],
      "cli_timeout_s": 1080,
      "fallback_reserve_s": 400,
      "min_cli_budget_s": 60
    },
    {
      "name": "fable-cli",
      "client": "claude",
      "model": "fable",
      "effort": "max",
      "fallback_model": "fable-latest",
      "cli_enabled": true,
      "host_dedup_frontends": [
        "claude"
      ],
      "cli_timeout_s": 1080,
      "fallback_reserve_s": 400,
      "min_cli_budget_s": 60
    }
  ]
}
